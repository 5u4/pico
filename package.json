{
  "name": "pico",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@biomejs/biome": "2.5.8",
      "@phosphor-icons/react": "2.1.10",
      "@radix-ui/react-context-menu": "2.3.7",
      "@tailwindcss/vite": "4.3.3",
      "@tanstack/react-router": "1.170.38",
      "@effect/atom-react": "4.0.0-rc.112",
      "@effect/language-service": "0.87.2",
      "@effect/platform-bun": "4.0.0-rc.112",
      "@effect/platform-node": "4.0.0-rc.112",
      "@effect/sql-sqlite-bun": "4.0.0-rc.112",
      "@effect/vitest": "4.0.0-rc.112",
      "@oh-my-pi/pi-agent-core": "18.1.17",
      "@oh-my-pi/pi-coding-agent": "18.1.17",
      "@oh-my-pi/pi-ai": "18.1.17",
      "@oh-my-pi/pi-utils": "18.1.17",
      "@types/bun": "1.4.2",
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.7",
      "@vitejs/plugin-react": "6.1.1",
      "effect": "4.0.0-rc.112",
      "discordeno": "21.0.0",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "tailwindcss": "4.3.3",
      "typescript": "7.0.2",
      "vite": "8.2.2",
      "vitest": "4.1.10"
    }
  },
  "scripts": {
    "prepare": "bun --bun run lefthook install",
    "fmt": "bun --bun run biome check --write",
    "lint": "bun --bun run biome check",
    "typecheck": "bun --bun run tsc --build --noEmit tsconfig.json packages/*/tsconfig.json",
    "test": "bun run typecheck && bun --bun x vitest run",
    "smoke": "bun --env-file=.env.smoke node_modules/vitest/vitest.mjs run --config vitest.smoke.config.ts",
    "vendor:effect": "bun scripts/vendor-effect.ts",
    "web:dev": "bun run --cwd packages/web dev",
    "web:build": "bun run --cwd packages/web build",
    "web:preview": "bun run --cwd packages/web preview"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@effect/atom-react": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/sql-sqlite-bun": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/vitest": "catalog:",
    "effect": "catalog:",
    "@oh-my-pi/pi-coding-agent": "catalog:",
    "@oh-my-pi/pi-agent-core": "18.1.17",
    "@pico/contract": "workspace:*",
    "@pico/daemon": "workspace:*",
    "@oh-my-pi/pi-ai": "catalog:",
    "@types/bun": "catalog:",
    "discordeno": "catalog:",
    "lefthook": "2.1.10",
    "starlight-theme-next": "^0.4.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "patchedDependencies": {
    "@oh-my-pi/pi-coding-agent@18.1.17": "patches/@oh-my-pi%2Fpi-coding-agent@18.1.17.patch"
  }
}
