{
  "name": "pico",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "@biomejs/biome": "2.5.8",
      "@effect/atom-react": "4.0.0-beta.107",
      "@effect/language-service": "0.87.2",
      "@effect/platform-bun": "4.0.0-beta.107",
      "@effect/sql-sqlite-bun": "4.0.0-beta.107",
      "@effect/vitest": "4.0.0-beta.107",
      "@oh-my-pi/pi-coding-agent": "18.0.10",
      "@types/bun": "1.3.14",
      "effect": "4.0.0-beta.107",
      "discordeno": "21.0.0",
      "react": "19.2.8",
      "typescript": "7.0.2",
      "vitest": "4.1.10"
    }
  },
  "scripts": {
    "prepare": "lefthook install",
    "fmt": "biome check --write",
    "lint": "biome check",
    "test": "bun --bun x vitest run",
    "smoke": "bun --bun x vitest run --config vitest.smoke.config.ts",
    "smoke:discord": "PICO_SMOKE_DISCORD=1 bun --env-file=.env.smoke node_modules/vitest/vitest.mjs run --config vitest.smoke.config.ts smoke/discord.smoke.ts",
    "daemon": "bun apps/daemon/src/main.ts",
    "vendor:effect": "bun scripts/vendor-effect.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/vitest": "catalog:",
    "@oh-my-pi/pi-coding-agent": "catalog:",
    "@types/bun": "catalog:",
    "discordeno": "catalog:",
    "lefthook": "2.1.10",
    "starlight-theme-next": "^0.4.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
